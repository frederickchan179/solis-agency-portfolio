{
  "name": "solis-agency-portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky && chmod ug+x .husky/*"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lionstone-digital/eslint-config-typescript": "^0.1.3",
    "@lionstone-digital/prettier-config": "^0.0.7",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,css,md,astro,json}": "prettier --write",
    "*.{js,mjs,ts,astro}": "eslint --fix"
  }
}
