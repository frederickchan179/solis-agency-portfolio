# Plain HTTP: Coolify's proxy terminates TLS in front of this container
:80 {
	root * /srv
	encode zstd gzip
	file_server

	# Astro hashes these file names, so they never change in place
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@html path / *.html
	header @html Cache-Control "no-cache"

	@public not path /_astro/* / *.html
	header @public Cache-Control "public, max-age=86400"

	header X-Content-Type-Options nosniff
}
