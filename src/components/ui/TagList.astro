---
interface Props {
  items: string[]
}

const { items } = Astro.props
---

<ul class='tag-list'>
  {items.map((item) => (
    <li>{item}</li>
  ))}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-content: start;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font: 400 12px/1.3 var(--mono);
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
  }
</style>
