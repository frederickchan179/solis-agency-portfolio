---
import JobPosting from '@/components/sections/JobPosting.astro'
import RetreatVideo from '@/components/sections/RetreatVideo.astro'
import Button from '@/components/ui/Button.astro'
import { jobs } from '@/data/jobs'
---

<section class='section gutter' id='careers' aria-labelledby='careers-title'>
  <div class='split'>
    <div class='section-intro'>
      <h2 class='section-title' id='careers-title'>
        Careers
      </h2>
    </div>
    <div class='stack'>
      <p class='section-text'>
        If you share the same values with us and are looking for a new opportunity to grow, look no further. This is
        where you can <strong class='slogan'>be the leader you are</strong>.
      </p>
      <div class='button-row'>
        <Button href='mailto:careers@solislab.com' solid arrow>
          Send your CV
        </Button>
        <Button href='#positions'>See Open Positions</Button>
      </div>
    </div>
  </div>

  <RetreatVideo />

  <div class='positions' id='positions'>
    {jobs.map((job) => (
      <JobPosting job={job} />
    ))}
  </div>
</section>

<style>
  .slogan {
    color: var(--sun);
    font-weight: 600;
  }

  .positions {
    margin-top: var(--block);
  }

  .positions :global(.accordion-title) {
    font-size: clamp(22px, 3vw, 40px);
  }
</style>
