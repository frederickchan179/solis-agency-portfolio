---
import { retreatVideo } from '@/data/jobs'
---

<figure class='retreat split'>
  <div class='retreat-media'>
    <button
      class='video-play'
      type='button'
      data-vimeo={retreatVideo.id}
      data-cursor='Play'
      aria-label={`Play video: ${retreatVideo.title}`}
    >
      <img src={retreatVideo.poster} alt='' width='1280' height='720' loading='lazy' decoding='async' />
      <span class='video-play-icon' aria-hidden='true'></span>
    </button>
  </div>
  <figcaption>
    <span class='label'>Latest video</span>
    <h3>{retreatVideo.title}</h3>
    <p>{retreatVideo.caption}</p>
  </figcaption>
</figure>

<script>
  import { initVideo } from '@/scripts/video'

  initVideo()
</script>

<style>
  .retreat {
    margin: var(--block) 0 0;
  }

  .retreat-media {
    position: relative;
    aspect-ratio: 16/9;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 30%, rgba(254, 195, 33, 0.22), transparent 45%),
      linear-gradient(160deg, var(--navy), var(--night));
  }

  /* The player iframe is created by the video script, so it has no scoped attribute */
  .retreat-media :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-play {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .video-play img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transition:
      opacity 0.4s,
      transform 0.8s var(--ease);
  }

  .video-play-icon {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--sun);
    position: relative;
    z-index: 1;
    transition: transform 0.4s var(--ease);
  }

  .video-play-icon::after {
    content: '';
    position: absolute;
    left: 34px;
    top: 27px;
    border-style: solid;
    border-width: 15px 0 15px 24px;
    border-color: transparent transparent transparent var(--navy);
  }

  /* Mouse only: on touch screens a tap leaves :hover stuck */
  @media (hover: hover) {
    .video-play:hover img {
      opacity: 1;
      transform: scale(1.03);
    }

    .video-play:hover .video-play-icon {
      transform: scale(1.08);
    }
  }

  figcaption {
    display: grid;
    gap: 10px;
  }

  h3 {
    margin: 0;
    font: 500 clamp(26px, 3vw, 40px)/1.1 var(--display);
  }

  p {
    margin: 0;
    color: var(--muted);
    max-width: 48ch;
  }
</style>
