---
import Button from '@/components/ui/Button.astro'
---

<section class='section gutter' id='schedule' aria-labelledby='lets-talk-title'>
  <div class='split'>
    <h2 class='section-title' id='lets-talk-title'>
      Let's
      <br />
      talk
    </h2>
    <div class='stack'>
      <p class='section-text'>
        Need a hand with any of the above? Shoot us a short email and we'll jump on a quick call or chat with you to
        discuss your engineering needs.
      </p>
      <div>
        <Button href='mailto:collab@solislab.com' solid arrow>
          Schedule a call
        </Button>
      </div>
    </div>
  </div>
</section>
