---
import Button from '@/components/ui/Button.astro'
import SectionTitle from '@/components/ui/SectionTitle.astro'
import { email } from '@/data/contact'
import { letsTalk } from '@/data/services'
---

<section class='section gutter' id='schedule' aria-labelledby='lets-talk-title'>
  <div class='split'>
    <SectionTitle id='lets-talk-title' lines={letsTalk.title} />
    <div class='stack'>
      <p class='section-text'>{letsTalk.text}</p>
      <div>
        <Button href={`mailto:${email.partnership}`} solid arrow>
          Schedule a call
        </Button>
      </div>
    </div>
  </div>
</section>
