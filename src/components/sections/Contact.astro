---
import Clock from '@/components/ui/Clock.astro'
import CopyField from '@/components/ui/CopyField.astro'
import { contactCards, office } from '@/data/contact'

// Pre-sized WebP files (Astro's image service would need sharp as a dependency)
const teamPhotoBase = '/images/team/team'
---

<section class='section gutter' id='contact' aria-labelledby='contact-title'>
  <!-- Real faces next to the contact details: the people who answer the email -->
  <figure class='team-photo'>
    <img
      src={`${teamPhotoBase}-1280.webp`}
      srcset={[640, 960, 1280, 1920].map((width) => `${teamPhotoBase}-${width}.webp ${width}w`).join(', ')}
      sizes='100vw'
      width='2558'
      height='1360'
      alt='The Solis Lab team in Solis Lab T-shirts'
      loading='lazy'
      decoding='async'
    />
  </figure>
  <div class='section-intro contact-intro'>
    <h2 class='section-title' id='contact-title'>
      Get In
      <br />
      Touch
    </h2>
    <p class='lede'>
      If you have any inquiry or questions, feel free to contact us via email. Our team will respond to you within 12
      hours.
    </p>
  </div>
  <div class='contact-grid'>
    {contactCards.map(({ label, title, links }) => (
      <div class='contact-card'>
        <h3 class='label'>{label}</h3>
        <p class='contact-card-title'>{title}</p>
        {links.map((link) => (
          <CopyField {...link} />
        ))}
      </div>
    ))}
  </div>
  <div class='office'>
    <div>
      <h3 class='label'>
        {office.label} <Clock /> GMT+7
      </h3>
      <address>{office.address}</address>
    </div>
  </div>
</section>

<style>
  /* Full-bleed band that fades into the page at the top and bottom; the title rises over its faded lower edge */
  .team-photo {
    margin: 0 calc(50% - 50vw);
    height: clamp(260px, 44vw, 680px);
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 55%, transparent);
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }

  .contact-intro {
    position: relative;
    margin-top: calc(clamp(260px, 44vw, 680px) * -0.28);
  }

  /* 1px gaps over a line-coloured background draw the borders between cards */
  .contact-grid {
    margin-top: var(--block);
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    grid-template-columns: 1fr;
  }

  /* Three columns only once each card fits an email address on one line */
  @media (min-width: 1100px) {
    .contact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contact-card {
    background: var(--night);
    padding: clamp(22px, 3vw, 36px);
    display: grid;
    gap: 10px;
    align-content: start;
    min-width: 0;
    transition: background 0.3s;
  }

  /* Mouse only: on touch screens a tap leaves :hover stuck */
  @media (hover: hover) {
    .contact-card:hover {
      background: color-mix(in srgb, var(--night), var(--ink) 3%);
    }
  }

  h3 {
    margin: 0;
  }

  .contact-card-title {
    margin: 0;
    font: 500 26px/1.1 var(--display);
  }

  .office {
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
    margin-top: clamp(28px, 4vw, 48px);
  }

  @media (min-width: 760px) {
    .office {
      grid-template-columns: 1fr 1fr;
    }
  }

  address {
    margin-top: 10px;
    font-style: normal;
    font-size: 18px;
  }
</style>
